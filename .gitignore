.env
.env.*
.venv
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Factory build output: generated repos are their own git repos,
# and the build log is a run artifact, not source.
factory_workspace/
factory_build.log
factory_runs/

# Playwright MCP scratch (snapshots, console logs)
.playwright-mcp/

# Gemini Agent
.gemini-agent/cache/

# Visual review verdict cache (content-addressed)
.visual_cache/

# Client deliverables and client-specific inputs. The contracts that
# graded them (contracts/) are the record that belongs in version
# control; the documents themselves belong to the client.
drops/inbox/
drops/outbox/
# Every orch2 import lands here, and orch2 plans client work. The four
# demo architectures already tracked stay tracked (ignore rules never
# apply to tracked files); nothing new gets in without deciding to.
specs/*.architecture.json
